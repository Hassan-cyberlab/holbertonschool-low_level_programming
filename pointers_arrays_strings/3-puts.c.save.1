#include <stdio.h>
/**
 * print_rev - prints a string in reverse, followed by a new line
 * @str: the string to print
 */
void print_rev(char *str)
{
	int i = 0;
	int len = 0;
	char *endOfString;

	while(str[i] != '\0')
	{
		endOfString = &str[i];
		i++;
		len++;
	}

printf("%c",*endOfString);
}


int main(void)
{
print_rev("Hello");
return (0);
}
